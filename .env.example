# ==============================================================================
# CRYPTONITE CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Environment
CRYPTONITE_ENV=development
LOG_LEVEL=INFO

# Security & Crypto Configuration Defaults
DEFAULT_PBKDF2_ITERATIONS=600000
DEFAULT_COMPRESSION_LEVEL=6
MAX_UPLOAD_SIZE_MB=50

# REST API Configuration (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Web UI Configuration (Streamlit)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_THEME_BASE=dark

# ==============================================================================
# OPTIONAL EXTERNAL INTEGRATIONS (FREE TIERS / OPEN-SOURCE APIS)
# ==============================================================================

# GitHub Personal Access Token (for CI/CD workflows, automated releases)
# Generate at: https://github.com/settings/tokens (Scopes: repo, workflow)
GITHUB_TOKEN=your_github_token_here

# Hugging Face Access Token (for downloading pre-trained neural steganalysis models e.g. SRNet)
# Generate at: https://huggingface.co/settings/tokens (Role: Read)
HF_TOKEN=your_huggingface_token_here

# VirusTotal API Key (for automated anti-forensics / AV false positive validation)
# Generate at: https://www.virustotal.com/gui/user/your-username/apikey
VT_API_KEY=your_virustotal_api_key_here
